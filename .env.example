# smeta-checker — copy to .env and fill the required values.
# Secrets stay local; .gitignore covers .env.

# ─── Required ───────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
AUDIT_API_TOKEN=

# ─── LLM provider ───────────────────────────────────────────────
# RouterAI (default). MODEL — exact id from the RouterAI catalogue.
ROUTERAI_API_KEY=
ROUTERAI_MODEL=deepseek/deepseek-v4.1-flash
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# Yandex Cloud (used when RouterAI is empty).
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER=
#YANDEX_CLOUD_MODEL=qwen3.6-35b-a3b/latest

# AnyModel (takes precedence over Yandex when set).
#ANYMODEL_API_KEY=
#ANYMODEL_MODEL=ds/deepseek-v4-flash
#ANYMODEL_BASE_URL=https://anymodel.org/v1

# ─── Workspace login: local (empty) or ldap ─────────────────────
WORKSPACE_AUTH_MODE=
WORKSPACE_LOGIN=
WORKSPACE_PASSWORD=

# ─── Network: localhost only unless overridden ──────────────────
# Intranet: LAN IP/hostname. World: domain + TLS proxy above.
#NUXT_PUBLIC_HOST=192.168.1.10
#WORKSPACE_BIND=0.0.0.0
#WORKSPACE_PORT=3000
WORKSPACE_ORIGIN=
# Compose sets redis://redis:6379/1; override only outside Docker.
#WORKSPACE_REDIS_URL=

# ─── Active Directory (only when WORKSPACE_AUTH_MODE=ldap) ──────
#LDAP_URL=ldaps://ad.example.com:636
#LDAP_TLS_MODE=ldaps          # ldaps | starttls | none
#LDAP_BASE_DN=DC=example,DC=com
#LDAP_DOMAIN=example.com
#LDAP_BIND_DN=CN=smeta,CN=Users,DC=example,DC=com
#LDAP_BIND_PASSWORD=
#LDAP_ACCESS_MODE=group       # group | all
#LDAP_GROUP_DN=
#LDAP_CA_FILE=
#LDAP_CA_HOST_FILE=

# ─── Telemetry ──────────────────────────────────────────────────
# Phoenix tracing (empty endpoint = disabled).
#PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
#PHOENIX_PROJECT_NAME=smeta-checker
#PHOENIX_PUBLIC_URL=http://localhost:6006
#PHOENIX_ENVIRONMENT=production

# GlitchTip / Sentry.
#GLITCHTIP_DSN=
#NUXT_PUBLIC_SENTRY_DSN=
#SENTRY_ENVIRONMENT=production
#SENTRY_RELEASE=
#SENTRY_TRACES_SAMPLE_RATE=0.05

# ─── MCP (OpenWebUI / IDE) ──────────────────────────────────────
# .mcp.json declares these servers; set the reachable endpoint here.
# OpenWebUI: Admin → Settings → Tools → MCP → Add (URL/Type/Auth: none)
PHOENIX_MCP_URL=http://localhost:6006/mcp
# Requires GLITCHTIP_ENABLE_MCP=true on the GlitchTip server.
GLITCHTIP_MCP_URL=http://localhost:8001/mcp

# ─── Normative knowledge bases ──────────────────────────────────
# Empty dirs keep compose bind mounts valid; normative checks return
# needs_facts until real releases are placed there.
NORMATIVE_KB_HOST_ROOT=./.local-empty-kb/electrical-norms
NORMATIVE_ROAD_KB_HOST_ROOT=./.local-empty-kb/road-norms

# ─── Optional tuning (defaults shown) ───────────────────────────
#POSTGRES_USER=smeta
#POSTGRES_DB=smeta
#API_PORT=8000
#AUDIT_LLM_CONCURRENCY=8
#AUDIT_PDF_CONCURRENCY=2
#AUDIT_NORMATIVE_CONCURRENCY=2
#AUDIT_MAX_TASKS_PER_CHILD=50
#AUDIT_TASK_SOFT_TIME_LIMIT=540
#AUDIT_TASK_TIME_LIMIT=600
#AUDIT_MAX_UPLOAD_BYTES=104857600
#AUDIT_MAX_UPLOADS_PER_REQUEST=32
#AUDIT_ALLOWED_LLM_HOSTS=ai.api.cloud.yandex.net
# DeepSeek, USD за 1K токенов; RUB/1M ÷ 1000 ÷ 82.8
#AUDIT_LLM_INPUT_COST_PER_1K=0.0000966
#AUDIT_LLM_OUTPUT_COST_PER_1K=0.0001449
#AUDIT_LLM_CACHE_READ_COST_PER_1K=0.0000100
#AUDIT_TELEMETRY_MASK_PROMPTS=0
#AUDIT_TELEMETRY_REDACT_PDF=0
#NORMATIVE_AUTO_ENABLED=1
#TESSDATA_PREFIX=

# ─── Optional stacks ────────────────────────────────────────────
# Phoenix:        docker compose -f compose.yaml -f compose.phoenix.yaml up -d
#PHOENIX_PORT=6006
#PHOENIX_BIND=127.0.0.1

# Monitoring:     docker compose -f compose.yaml -f compose.monitoring.yaml up -d
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=change-me
#GRAFANA_ROOT_URL=http://localhost:3001
#GRAFANA_PORT=3001
#GRAFANA_BIND=127.0.0.1
#PROMETHEUS_PORT=9090
#PROMETHEUS_BIND=127.0.0.1
#LOKI_PORT=3100
#LOKI_BIND=127.0.0.1
#CADVISOR_PORT=8081
#CADVISOR_BIND=127.0.0.1

# Self-hosted GlitchTip: docker compose -f compose.glitchtip.yaml up -d
#GLITCHTIP_SECRET_KEY=change-me-long-random
#GLITCHTIP_DOMAIN=http://localhost:8001
#GLITCHTIP_PORT=8001
#GLITCHTIP_BIND=127.0.0.1
#GLITCHTIP_EMAIL_URL=consolemail://
#GLITCHTIP_DEFAULT_FROM_EMAIL=glitchtip@localhost
#GLITCHTIP_ENABLE_USER_REGISTRATION=true
#GLITCHTIP_ENABLE_MCP=false
#GLITCHTIP_ALLOWED_HOSTS=*

# Docling (compose.yaml service `docling`)
#DOCLING_SERVE_ENDPOINT=http://docling:5001
#DOCLING_SERVE_TIMEOUT=600
#DOCLING_SERVE_PAGE_BATCH=8
#DOCLING_SERVE_TABLE_STRUCTURE=false
#DOCLING_SERVE_TABLE_STRUCTURE_PRESET=kdfp
